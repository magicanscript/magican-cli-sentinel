
SOLANA_TARGET_RPC_URL=http://your-node:8899

SOLANA_REFERENCE_RPC_URL=https://api.mainnet-beta.solana.com

SENTINEL_POLL_INTERVAL_SECS=10

SENTINEL_SLOT_LAG_THRESHOLD=5

SENTINEL_RTT_THRESHOLD_MS=500

SENTINEL_ALERT_COOLDOWN_SECS=300

# Необязательный: при пустом/отсутствующем значении заголовок Authorization
# не отправляется (нужно для локальной Ollama).
LLM_API_KEY=your-llm-api-key-here

LLM_MODEL=mistral-small-latest

# OpenAI-совместимый API root. По умолчанию Mistral.
# Смените для другого провайдера, например:
#   OpenAI:  https://api.openai.com/v1
#   Groq:    https://api.groq.com/openai/v1
#   Ollama:  http://localhost:11434/v1   (LLM_API_KEY можно не задавать)
LLM_BASE_URL=https://api.mistral.ai/v1

TELEGRAM_BOT_TOKEN=123456789:ABCDEFabcdef-your-bot-token-here

TELEGRAM_CHAT_ID=123456789
